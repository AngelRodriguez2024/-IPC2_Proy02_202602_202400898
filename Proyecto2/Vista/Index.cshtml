@model Proyecto2.Models.ArbolCategorias

@{
    ViewData["Title"] = "Catálogo de Librería";
}

<h2>Gestión del Catálogo de Libros</h2>

<!-- 1. Carga de Archivo XML -->
<div style="border: 1px solid #ccc; padding: 15px; margin-bottom: 20px;">
    <h3>Cargar Archivo XML</h3>
    <form asp-action="CargarXml" method="post" enctype="multipart/form-data">
        <input type="file" name="archivoXml" accept=".xml" required />
        <button type="submit">Cargar XML</button>
    </form>
</div>

<!-- 2. Registro Manual de Categoría -->
<div style="border: 1px solid #ccc; padding: 15px; margin-bottom: 20px;">
    <h3>Agregar Nueva Categoría</h3>
    <form asp-action="AgregarCategoria" method="post">
        <label>Nombre Categoría:</label>
        <input type="text" name="nombre" required />
        
        <label>Categoría Padre (Opcional):</label>
        <input type="text" name="padre" />
        
        <button type="submit">Guardar Categoría</button>
    </form>
</div>

<!-- 3. Registro Manual de Libro -->
<div style="border: 1px solid #ccc; padding: 15px; margin-bottom: 20px;">
    <h3>Registrar Libro</h3>
    <form asp-action="RegistrarLibro" method="post">
        <label>ISBN (Número):</label>
        <input type="number" name="isbn" required />
        
        <label>Título:</label>
        <input type="text" name="titulo" required />
        
        <label>Autor:</label>
        <input type="text" name="autor" required />
        
        <label>Categoría Asignada:</label>
        <input type="text" name="categoria" required />
        
        <button type="submit">Guardar Libro</button>
    </form>
</div>

<!-- 4. Búsqueda y Eliminación por ISBN -->
<div style="border: 1px solid #ccc; padding: 15px; margin-bottom: 20px;">
    <h3>Acciones de Libro</h3>
    <form asp-action="BuscarLibro" method="get" style="display:inline-block; margin-right: 20px;">
        <label>ISBN:</label>
        <input type="number" name="isbn" required />
        <label>Categoría:</label>
        <input type="text" name="categoria" required />
        <button type="submit">Buscar</button>
    </form>

    <form asp-action="EliminarLibro" method="post" style="display:inline-block;">
        <label>ISBN:</label>
        <input type="number" name="isbn" required />
        <label>Categoría:</label>
        <input type="text" name="categoria" required />
        <button type="submit" onclick="return confirm('¿Eliminar libro?')">Eliminar</button>
    </form>
</div>

@if (ViewBag.LibroEncontrado != null)
{
    <div style="background-color: #e2f0d9; padding: 10px; margin-bottom: 20px;">
        <h4>Libro Encontrado:</h4>
        <p><strong>ISBN:</strong> @ViewBag.LibroEncontrado.ISBN</p>
        <p><strong>Título:</strong> @ViewBag.LibroEncontrado.Titulo</p>
        <p><strong>Autor:</strong> @ViewBag.LibroEncontrado.Autor</p>
        <p><strong>Categoría:</strong> @ViewBag.LibroEncontrado.Categoria</p>
    </div>
}

<!-- 5. Reportes Graphviz -->
<div style="border: 1px solid #ccc; padding: 15px; margin-bottom: 20px;">
    <h3>Reportes Graphviz (Código DOT)</h3>

    <!-- Generar Árbol de Categorías -->
    <a href="@Url.Action("ReporteCategorias", "Catalog")" class="btn btn-primary" style="margin-bottom: 15px; display: inline-block;">
        Generar Reporte de Categorías (N-Ario)
    </a>

    @if (ViewBag.DotCategorias != null)
    {
        <h4>Código DOT - Estructura de Categorías:</h4>
        <textarea rows="8" cols="80" readonly style="font-family: monospace;">@ViewBag.DotCategorias</textarea>
    }

    <hr />

    <!-- Generar Árbol AVL de una Categoría -->
    <form asp-action="ReporteAVL" method="get" style="margin-top: 15px;">
        <label>Categoría para ver AVL:</label>
        <input type="text" name="categoria" required />
        <button type="submit">Generar Reporte AVL</button>
    </form>

    @if (ViewBag.DotAVL != null)
    {
        <h4 style="margin-top: 15px;">Código DOT - Árbol AVL (@ViewBag.CategoriaReporte):</h4>
        <textarea rows="8" cols="80" readonly style="font-family: monospace;">@ViewBag.DotAVL</textarea>
    }
</div>